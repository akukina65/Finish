<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="DemoText12.Views.LoginView"
             xmlns:vm="using:DemoText12.ViewModels"
             x:DataType="vm:LoginViewModel"
             FontFamily="Times New Romen">
<Grid RowDefinitions="30,*">
    <Border Background="#7FFF00">
        <TextBlock Text="Авторизация" HorizontalAlignment="Center" FontSize="20"></TextBlock>
    </Border>

    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Image Source="avares://DemoText12/Assets/Icon.png" Width="150" Height="150"></Image>
        <TextBlock Text="Введите логин"></TextBlock>
        <TextBox Text="{Binding Login}"></TextBox>
        <TextBlock Text="Введите пароль"></TextBlock>
        <TextBox Text="{Binding Password}"></TextBox>
        <Button Content="Войти" Command="{Binding Enter}" HorizontalAlignment="Center"></Button>
         <Button Content="Войти как гость" Command="{Binding GuestScreen}" HorizontalAlignment="Center" Background="#00FA9A"></Button>
    </StackPanel>
</Grid>
</UserControl>
